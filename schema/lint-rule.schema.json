{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HPC Client GUI lint rules file (Plugin API v1)",
  "type": "object",
  "required": ["schema_version", "tool", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/rule"}
    }
  },
  "definitions": {
    "severity": {
      "enum": ["error", "warning", "info"]
    },
    "matchKind": {
      "enum": [
        "regex-line",
        "regex-block",
        "required-keyword",
        "forbidden-keyword",
        "ordered-patterns",
        "count"
      ],
      "description": "Declarative match kinds only; the app owns the matching engine. Kebab-case aliases map to engine primitives (required-keyword=contains, forbidden-keyword=not_contains, regex-line=line_regex, regex-block=regex, ordered-patterns=ordered_patterns)."
    },
    "whenCondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_version": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+){0,2}(\\.\\*)?$",
          "description": "Only apply this rule when the user/application target version matches."
        },
        "remote_platform": {
          "type": "string",
          "minLength": 1,
          "description": "Case-insensitive substring match against the remote execution platform (e.g. 'linux'). Rules are skipped when the context is unknown."
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "severity", "message", "match"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "maxLength": 64
        },
        "severity": {"$ref": "#/definitions/severity"},
        "message": {"type": "string", "minLength": 1},
        "category": {"type": "string", "maxLength": 64},
        "explanation": {"type": "string"},
        "suggested_fix": {"type": "string"},
        "documentation_url": {"type": "string", "pattern": "^https://"},
        "when": {"$ref": "#/definitions/whenCondition"},
        "match": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": {"$ref": "#/definitions/matchKind"},
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Pattern or keyword text. Catastrophic nested-quantifier regexes are rejected by the app validator."
            },
            "patterns": {
              "type": "array",
              "minItems": 2,
              "items": {"type": "string", "minLength": 1, "maxLength": 512},
              "description": "ordered-patterns only: expected textual sequence."
            },
            "require_all": {
              "type": "boolean",
              "description": "ordered-patterns only: when true (default), a diagnostic fires even if some patterns are absent; when false, all patterns must be present but out of order."
            },
            "min": {"type": "integer", "minimum": 0},
            "max": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
