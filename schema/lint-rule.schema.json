{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HPC Client GUI lint rules file (Plugin API v1)",
  "type": "object",
  "required": ["schema_version", "tool", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/rule"}
    }
  },
  "definitions": {
    "severity": {
      "enum": ["error", "warning", "info"]
    },
    "matchKind": {
      "enum": [
        "regex-line",
        "regex-block",
        "required-keyword",
        "forbidden-keyword"
      ],
      "description": "Declarative match kinds only; the app owns the matching engine."
    },
    "rule": {
      "type": "object",
      "required": ["id", "severity", "message", "match"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "maxLength": 64
        },
        "severity": {"$ref": "#/definitions/severity"},
        "message": {"type": "string", "minLength": 1},
        "explanation": {"type": "string"},
        "fix_hint": {"type": "string"},
        "match": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"$ref": "#/definitions/matchKind"}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "regex-line",
                      "regex-block",
                      "required-keyword",
                      "forbidden-keyword"
                    ]
                  }
                }
              },
              "then": {
                "required": ["value"],
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "not": {"pattern": "\\(\\?<.*>\\)\\{\\d+,\\d+\\}"},
                    "description": "Pattern or keyword text. Catastrophic nested-quantifier patterns are rejected."
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
