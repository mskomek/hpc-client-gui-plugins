{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HPC Client GUI template content metadata (Plugin API v1)",
  "type": "object",
  "required": ["schema_version", "id", "title", "body"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "maxLength": 64
    },
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "placeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 64
          },
          "description": {"type": "string"},
          "required": {"type": "boolean"}
        }
      }
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "description": "Textual template body; declarative text only, never code."
    }
  }
}
