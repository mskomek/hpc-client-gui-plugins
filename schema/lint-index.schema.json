{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HPC Client GUI lint index (Plugin API v1)",
  "type": "object",
  "required": ["schema_version", "tool", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Identifier of the lint tool, e.g. fluent-journal."
    },
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "rule_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/definitions/sha256Hex"}
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {"$ref": "#/definitions/lintRuleSummary"}
    }
  },
  "definitions": {
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "severity": {
      "enum": ["error", "warning", "info"]
    },
    "lintRuleSummary": {
      "type": "object",
      "required": ["id", "severity", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "maxLength": 64
        },
        "severity": {"$ref": "#/definitions/severity"},
        "summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
