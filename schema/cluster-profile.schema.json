{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HPC Client GUI cluster profile payload (Plugin API v1/v2)",
  "type": "object",
  "oneOf": [
    {"$ref": "#/definitions/v1"},
    {"$ref": "#/definitions/v2"}
  ],
  "definitions": {
    "v1": {
      "type": "object",
      "required": ["schema_version", "profile_id", "name", "scheduler"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 64},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string"},
        "scheduler": {"enum": ["slurm"]},
        "paths": {"$ref": "#/definitions/paths"},
        "commands": {"$ref": "#/definitions/commands"},
        "documentation": {"type": "string"},
        "metadata": {"$ref": "#/definitions/metadata"}
      }
    },
    "v2": {
      "type": "object",
      "required": ["schema_version", "profile_id", "name", "scheduler"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 2},
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 64},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string"},
        "scheduler": {"enum": ["slurm"]},
        "paths": {"$ref": "#/definitions/paths"},
        "commands": {"$ref": "#/definitions/commands"},
        "metadata": {"type": "object", "additionalProperties": true},
        "site": {"type": "object", "additionalProperties": true},
        "scheduler_hints": {"type": "object", "additionalProperties": true},
        "software": {"type": "object", "additionalProperties": true},
        "storage": {"type": "array", "items": {"$ref": "#/definitions/storage"}},
        "quota_sources": {"type": "array", "items": {"$ref": "#/definitions/quota_source"}}
      }
    },
    "paths": {
      "type": "object", "additionalProperties": false,
      "properties": {"home_dir": {"type": "string"}, "scratch_dir": {"type": "string"}}
    },
    "commands": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "squeue_command": {"type": "string"}, "sbatch_command": {"type": "string"},
        "scancel_command": {"type": "string"}, "sacct_command": {"type": "string"},
        "scontrol_command": {"type": "string"}, "status_command": {"type": "string"},
        "active_job_ids_command": {"type": "string"}, "job_state_command": {"type": "string"}
      }
    },
    "metadata": {"type": "object", "additionalProperties": false, "properties": {
      "maintainer": {"type": "string"}, "documentation_url": {"type": "string", "pattern": "^https://"},
      "support_url": {"type": "string", "pattern": "^https://"}, "project_url": {"type": "string", "pattern": "^https://"},
      "last_verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    }},
    "storage": {"type": "object", "required": ["id", "label"], "additionalProperties": true, "properties": {
      "id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1},
      "enabled": {"type": "boolean"}, "kind": {"type": "string"}, "path_template": {"type": "string"}
    }},
    "quota_source": {"type": "object", "required": ["id"], "additionalProperties": true, "properties": {
      "id": {"type": "string", "minLength": 1}, "enabled": {"type": "boolean"},
      "backend_id": {"type": "string"}, "command_template": {"type": "string"}
    }}
  }
}
