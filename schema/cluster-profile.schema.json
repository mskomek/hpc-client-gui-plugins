{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HPC Client GUI cluster profile payload (Plugin API v1/v2)",
  "type": "object",
  "oneOf": [
    {"$ref": "#/definitions/v1"},
    {"$ref": "#/definitions/v2"}
  ],
  "definitions": {
    "v1": {
      "type": "object",
      "required": ["schema_version", "profile_id", "name", "scheduler"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 64},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string"},
        "scheduler": {"enum": ["slurm"]},
        "paths": {"$ref": "#/definitions/paths"},
        "commands": {"$ref": "#/definitions/commands"},
        "documentation": {"type": "string"},
        "metadata": {"$ref": "#/definitions/metadata"}
      }
    },
    "v2": {
      "type": "object",
      "required": ["schema_version", "profile_id", "name", "scheduler"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 2},
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 64},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string"},
        "scheduler": {"enum": ["slurm"]},
        "paths": {"$ref": "#/definitions/paths"},
        "commands": {"$ref": "#/definitions/commands"},
        "metadata": {"$ref": "#/definitions/v2_metadata"},
        "site": {"$ref": "#/definitions/site"},
        "scheduler_hints": {"$ref": "#/definitions/scheduler_hints"},
        "software": {"$ref": "#/definitions/software"},
        "storage": {"type": "array", "items": {"$ref": "#/definitions/storage"}},
        "quota_sources": {"type": "array", "items": {"$ref": "#/definitions/quota_source"}}
      }
    },
    "paths": {
      "type": "object", "additionalProperties": false,
      "properties": {"home_dir": {"type": "string"}, "scratch_dir": {"type": "string"}}
    },
    "commands": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "squeue_command": {"type": "string"}, "sbatch_command": {"type": "string"},
        "scancel_command": {"type": "string"}, "sacct_command": {"type": "string"},
        "scontrol_command": {"type": "string"}, "status_command": {"type": "string"},
        "active_job_ids_command": {"type": "string"}, "job_state_command": {"type": "string"}
      }
    },
    "metadata": {"type": "object", "additionalProperties": false, "properties": {
      "maintainer": {"type": "string"}, "documentation_url": {"type": "string", "pattern": "^https://"},
      "support_url": {"type": "string", "pattern": "^https://"}, "project_url": {"type": "string", "pattern": "^https://"},
      "last_verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    }},
    "v2_metadata": {"type": "object", "additionalProperties": false, "properties": {
      "maintainer": {"type": "string"}, "documentation_url": {"type": "string", "pattern": "^https://"},
      "support_url": {"type": "string", "pattern": "^https://"}, "project_url": {"type": "string", "pattern": "^https://"},
      "last_verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    }},
    "site": {"type": "object", "additionalProperties": false, "properties": {
      "public_name": {"type": "string"}, "region": {"type": "string"}, "access_note": {"type": "string"},
      "documentation_url": {"type": "string", "pattern": "^https://"}
    }},
    "scheduler_hints": {"type": "object", "additionalProperties": false, "properties": {
      "queue_notes": {"type": "string"}, "account_notes": {"type": "string"}, "partitions": {"type": "array", "items": {"type": "string"}}
    }},
    "software": {"type": "object", "additionalProperties": false, "properties": {
      "module_paths": {"type": "array", "items": {"type": "string"}}, "setup_notes": {"type": "string"}
    }},
    "storage": {"type": "object", "required": ["id", "label"], "additionalProperties": false, "properties": {
      "id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1},
      "enabled": {"type": "boolean"}, "kind": {"type": "string"}, "path_template": {"type": "string"},
      "legacy_path_key": {"type": "string"}, "purpose": {"type": "string"},
      "access_context": {"type": "string"}, "quota_source_id": {"type": "string"},
      "quota_pool_id": {"type": "string"}, "policy": {"$ref": "#/definitions/policy"}
    }},
    "policy": {"type": "object", "additionalProperties": false, "properties": {
      "backup": {"type": ["boolean", "null"]}, "cleanup_note": {"type": "string"},
      "retention_days": {"type": ["integer", "null"], "minimum": 0},
      "documentation_url": {"type": "string", "pattern": "^https://"}, "source_refs": {"type": "array", "items": {"type": "string"}}
    }},
    "quota_source": {"type": "object", "required": ["id"], "additionalProperties": false, "properties": {
      "id": {"type": "string", "minLength": 1}, "enabled": {"type": "boolean"},
      "backend_id": {"type": "string"}, "command_template": {"type": "string"}, "scope": {"type": "string"},
      "subject_template": {"type": "string"}, "refresh_seconds": {"type": "integer", "minimum": 0},
      "timeout_seconds": {"type": "integer", "minimum": 0}, "source_refs": {"type": "array", "items": {"type": "string"}},
      "note": {"type": "string"}
    }}
  }
}
