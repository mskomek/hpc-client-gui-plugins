{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HPC Client GUI cluster profile payload (Plugin API v1/v2/v3)",
  "type": "object",
  "oneOf": [
    {"$ref": "#/definitions/v1"},
    {"$ref": "#/definitions/v2"},
    {"$ref": "#/definitions/v3"}
  ],
  "definitions": {
    "v1": {
      "type": "object",
      "required": ["schema_version", "profile_id", "name", "scheduler"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 64},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": ["string", "null"]},
        "scheduler": {"enum": ["slurm"]},
        "paths": {"$ref": "#/definitions/paths"},
        "commands": {"$ref": "#/definitions/commands"},
        "documentation": {"type": "string"},
        "metadata": {"$ref": "#/definitions/metadata"}
      }
    },
    "v2": {
      "type": "object",
      "required": ["schema_version", "profile_id", "name", "scheduler"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 2},
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 64},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": ["string", "null"]},
        "scheduler": {"enum": ["slurm"]},
        "paths": {"$ref": "#/definitions/paths"},
        "commands": {"$ref": "#/definitions/commands"},
        "metadata": {"$ref": "#/definitions/v2_metadata"},
        "site": {"$ref": "#/definitions/site"},
        "scheduler_hints": {"$ref": "#/definitions/scheduler_hints"},
        "software": {"$ref": "#/definitions/software"},
        "storage": {"type": "array", "items": {"$ref": "#/definitions/storage"}},
        "quota_sources": {"type": "array", "items": {"$ref": "#/definitions/quota_source"}}
      }
    },
    "v3": {
      "type": "object",
      "required": ["schema_version", "profile_id", "name", "scheduler"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 3},
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "maxLength": 64},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": ["string", "null"]},
        "scheduler": {"enum": ["slurm"]},
        "paths": {"$ref": "#/definitions/paths"},
        "commands": {"$ref": "#/definitions/commands"},
        "metadata": {"$ref": "#/definitions/v2_metadata"},
        "site": {"$ref": "#/definitions/site"},
        "scheduler_hints": {"$ref": "#/definitions/scheduler_hints"},
        "software": {"$ref": "#/definitions/software"},
        "storage": {"type": "array", "items": {"$ref": "#/definitions/storage"}},
        "quota_sources": {"type": "array", "items": {"$ref": "#/definitions/quota_source"}},
        "job_outputs": {"$ref": "#/definitions/job_outputs"},
        "file_filters": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/definitions/file_filter"}}
      }
    },
    "paths": {
      "type": "object", "additionalProperties": false,
      "properties": {"home_dir": {"type": ["string", "null"]}, "scratch_dir": {"type": ["string", "null"]}}
    },
    "commands": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "squeue_command": {"type": ["string", "null"]}, "sbatch_command": {"type": ["string", "null"]},
        "scancel_command": {"type": ["string", "null"]}, "sacct_command": {"type": ["string", "null"]},
        "scontrol_command": {"type": ["string", "null"]}, "status_command": {"type": ["string", "null"]},
        "active_job_ids_command": {"type": ["string", "null"]}, "job_state_command": {"type": ["string", "null"]}
      }
    },
    "metadata": {"type": "object", "additionalProperties": false, "properties": {
      "maintainer": {"type": ["string", "null"]}, "documentation_url": {"type": ["string", "null"], "pattern": "^https://"},
      "support_url": {"type": ["string", "null"], "pattern": "^https://"}, "project_url": {"type": ["string", "null"], "pattern": "^https://"},
      "source_refs": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
      "last_verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    }},
    "v2_metadata": {"type": "object", "additionalProperties": false, "properties": {
      "maintainer": {"type": ["string", "null"]}, "documentation_url": {"type": ["string", "null"], "pattern": "^https://"},
      "support_url": {"type": ["string", "null"], "pattern": "^https://"}, "project_url": {"type": ["string", "null"], "pattern": "^https://"},
      "source_refs": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
      "last_verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    }},
    "site": {"type": "object", "additionalProperties": false, "properties": {
      "public_name": {"type": ["string", "null"]}, "region": {"type": ["string", "null"]}, "access_note": {"type": ["string", "null"]},
      "documentation_url": {"type": ["string", "null"], "pattern": "^https://"}
    }},
    "scheduler_hints": {"type": "object", "additionalProperties": false, "properties": {
      "queue_notes": {"type": ["string", "null"]}, "account_notes": {"type": ["string", "null"]}, "partitions": {"type": "array", "items": {"type": "string"}}
    }},
    "software": {"type": "object", "additionalProperties": false, "properties": {
      "module_paths": {"type": "array", "items": {"type": "string"}}, "setup_notes": {"type": ["string", "null"]}
    }},
    "storage": {"type": "object", "required": ["id", "label"], "additionalProperties": false, "properties": {
      "id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1},
      "enabled": {"type": "boolean"}, "kind": {"type": ["string", "null"]}, "path_template": {"type": ["string", "null"]},
      "legacy_path_key": {"type": ["string", "null"]}, "purpose": {"type": ["string", "null"]},
      "access_context": {"type": ["string", "null"]}, "quota_source_id": {"type": ["string", "null"]},
      "quota_pool_id": {"type": ["string", "null"]}, "policy": {"$ref": "#/definitions/policy"}
    }},
    "policy": {"type": "object", "additionalProperties": false, "properties": {
      "backup": {"type": ["boolean", "null"]}, "cleanup_note": {"type": ["string", "null"]},
      "retention_days": {"type": ["integer", "null"], "minimum": 0},
      "documentation_url": {"type": ["string", "null"], "pattern": "^https://"}, "source_refs": {"type": "array", "items": {"type": "string"}}
    }},
    "quota_source": {"type": "object", "required": ["id"], "additionalProperties": false, "properties": {
      "id": {"type": "string", "minLength": 1}, "enabled": {"type": "boolean"},
      "backend_id": {"type": ["string", "null"]}, "command_template": {"type": ["string", "null"]}, "scope": {"type": ["string", "null"]},
      "subject_template": {"type": ["string", "null"]}, "refresh_seconds": {"type": "integer", "minimum": 0},
      "timeout_seconds": {"type": "integer", "minimum": 0}, "source_refs": {"type": "array", "items": {"type": "string"}},
      "note": {"type": ["string", "null"]}
    }},
    "labels": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": {"type": "string", "minLength": 1, "maxLength": 128},
        "tr": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "job_outputs": {
      "type": "object",
      "required": ["streams"],
      "additionalProperties": false,
      "properties": {
        "strategy": {"type": "string", "enum": ["explicit", "legacy"]},
        "streams": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/definitions/output_stream"}}
      }
    },
    "output_stream": {
      "type": "object",
      "required": ["id", "role", "labels", "resolver", "order"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "role": {"type": "string", "enum": ["stdout", "stderr", "custom"]},
        "labels": {"$ref": "#/definitions/labels"},
        "resolver": {"type": "string", "enum": ["slurm.stdout", "slurm.stderr", "workdir.relative"]},
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+$"},
        "order": {"type": "integer", "minimum": 0, "maximum": 100000}
      },
      "allOf": [
        {"if": {"properties": {"resolver": {"const": "workdir.relative"}}}, "then": {"required": ["relative_path"]}},
        {"if": {"properties": {"resolver": {"enum": ["slurm.stdout", "slurm.stderr"]}}}, "then": {"not": {"required": ["relative_path"]}}}
      ]
    },
    "file_filter": {
      "type": "object",
      "required": ["id", "labels", "order"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(?!all$|folders$|iso$|archives$|slurm$|shell$|other$)[a-z][a-z0-9_-]{0,63}$"},
        "labels": {"$ref": "#/definitions/labels"},
        "globs": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "suffixes": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "order": {"type": "integer", "minimum": 0, "maximum": 100000}
      },
      "anyOf": [{"required": ["globs"], "properties": {"globs": {"minItems": 1}}}, {"required": ["suffixes"], "properties": {"suffixes": {"minItems": 1}}}]
    }
  }
}
