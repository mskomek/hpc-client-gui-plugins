{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HPC Client GUI template index (Plugin API v1)",
  "type": "object",
  "required": ["schema_version", "templates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "content_path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "maxLength": 64
          },
          "title": {"type": "string", "minLength": 1},
          "category": {
            "enum": ["job-submission", "application", "documentation"]
          },
          "scheduler": {"enum": ["slurm"]},
          "content_path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/definitions/sha256Hex"}
        }
      }
    }
  },
  "definitions": {
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
