{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HPC Client GUI plugin manifest (Plugin API v1 or v2)",
  "type": "object",
  "required": [
    "schema_version",
    "plugin_api",
    "id",
    "name",
    "version",
    "publisher",
    "license",
    "description",
    "requires_app",
    "capabilities",
    "entrypoints",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plugin_api": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)+$",
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "$ref": "#/definitions/semver"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "requires_app": {
      "$ref": "#/definitions/versionRange"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/capability"
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster_profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lint_index": {
          "type": "string",
          "minLength": 1
        },
        "template_index": {
          "type": "string",
          "minLength": 1
        },
        "job_templates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Template index files delivering job templates."
        },
        "linter_engine": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the linter engine package __init__.py (Plugin API v2, role linter-engine)."
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/fileEntry"
      }
    }
  },
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": {
        "oneOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          {
            "pattern": "\\\\"
          },
          {
            "pattern": "[A-Za-z]:"
          },
          {
            "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*://"
          }
        ]
      }
    },
    "fileRole": {
      "enum": [
        "cluster-profile",
        "lint-index",
        "lint-rules",
        "template-index",
        "template-content",
        "documentation",
        "linter-engine",
        "linter-data"
      ]
    },
    "capability": {
      "enum": [
        "cluster-profile",
        "lint-rules",
        "job-template",
        "application-tools",
        "linter-tool"
      ]
    },
    "versionRange": {
      "type": "string",
      "pattern": "^(>=|<=|==|~=)?(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)){0,2}$"
    },
    "fileEntry": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "size",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/definitions/relativePath"
        },
        "sha256": {
          "$ref": "#/definitions/sha256Hex"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "$ref": "#/definitions/fileRole"
        }
      }
    }
  }
}
