#!/usr/bin/env bash
#SBATCH --job-name=openfoam-v2312
#SBATCH --nodes={{nodes}}
#SBATCH --ntasks={{ntasks}}
#SBATCH --time={{time_limit}}
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err

# Submit this draft from the case root containing the Allrun generated by Studio.
# Review cluster policy and module availability before submission.
# OpenFOAM's bashrc is not nounset/errexit-safe; enable strict mode after loading it.
set -eo pipefail

if ! command -v module >/dev/null 2>&1 && [[ -r /etc/profile.d/modules.sh ]]; then
    # shellcheck disable=SC1091
    source /etc/profile.d/modules.sh
fi
if ! command -v module >/dev/null 2>&1; then
    echo "Environment Modules is unavailable in this job shell." >&2
    exit 127
fi
module load apps/openfoam/v2312-2025

set +e
source "$WM_PROJECT_DIR/etc/bashrc"
openfoam_env_status=$?
set -e
if (( openfoam_env_status != 0 )); then
    echo "OpenFOAM environment initialization failed: $openfoam_env_status" >&2
    exit "$openfoam_env_status"
fi
set -u

if [[ ! -f Allrun ]]; then
    echo "Allrun is missing. Generate it in OpenFOAM Case Studio first." >&2
    exit 2
fi

exec bash ./Allrun
